{
  "description": "flow guardrails: active-task context at session start; branch, base-branch and PR-shape guards before git push / PR creation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.*github.*__(create_pull_request|push_files|create_or_update_file|delete_file))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
